{
  "python_requires": ">=3.10,<3.13",
  "seed": 42,
  "preprocessing": {
    "image_size": 256,
    "top_k_ratio": 0.005,
    "image_threshold_percentile": 95.0,
    "pixel_threshold_percentile": 99.5
  },
  "paths": {
    "dataset_root": "data/mvtec-ad",
    "artifacts_root": "artifacts"
  },
  "security": {
    "allow_random_init": false,
    "trusted_checkpoints_only": true
  }
}
